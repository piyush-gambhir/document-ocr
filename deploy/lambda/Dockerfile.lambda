FROM public.ecr.aws/lambda/python:3.12
RUN microdnf install -y mesa-libGL glib2 libgomp && microdnf clean all
COPY requirements.lock ${LAMBDA_TASK_ROOT}/requirements.lock
RUN python -m pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements.lock
COPY core/ ${LAMBDA_TASK_ROOT}/core/
ARG DOCUMENT_OCR_KYC_LANGS=en
ENV DOCUMENT_OCR_KYC_LANGS=${DOCUMENT_OCR_KYC_LANGS} PYTHONDONTWRITEBYTECODE=1
# Lambda has a read-only root filesystem: package every selected model now.
RUN python -m core.model_setup
COPY deploy/lambda/handler.py ${LAMBDA_TASK_ROOT}/handler.py
CMD ["handler.handler"]
