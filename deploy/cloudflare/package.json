    "check:image": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "overrides": {
    "undici@>=7.0.0 <7.30.1": "7.30.1"
  }
}
