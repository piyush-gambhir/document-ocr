{
  "name": "document-ocr-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "bash deploy.sh",
    "typecheck": "tsc --noEmit",
    "check": "wrangler deploy --dry-run --containers-rollout=none --outdir .wrangler/dry-run",
    "types": "wrangler types",
