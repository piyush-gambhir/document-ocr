{
  "name": "document-ocr",
  "version": "2.0.0",
  "description": "Standalone passport OCR — scans passports locally with bundled Python pipeline",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "python",
    "scripts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/piyush-gambhir/document-ocr"
  },
  "keywords": ["passport", "ocr", "mrz", "rapidocr", "onnx", "document-scanning", "standalone"],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "sync-python": "bash scripts/sync-python.sh",
    "build": "bash scripts/sync-python.sh && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "optionalDependencies": {
    "@aws-sdk/client-lambda": "^3.500.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
