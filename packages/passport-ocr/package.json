{
  "name": "document-ocr",
  "version": "3.1.0",
  "description": "Local and hosted OCR SDK for passports, Indian KYC and experimental US identity, immigration and tax documents",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "python",
    "scripts",
    "README.md",
    "hosting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/piyush-gambhir/document-ocr"
  },
  "homepage": "https://github.com/piyush-gambhir/document-ocr#readme",
  "bugs": {
    "url": "https://github.com/piyush-gambhir/document-ocr/issues"
  },
  "author": "Piyush Gambhir",
  "keywords": [
    "passport",
    "ocr",
    "mrz",
    "rapidocr",
    "onnx",
    "aadhaar",
    "pan",
    "kyc",
    "nrega",
    "npr",
    "document-scanning",
    "standalone"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "sync-python": "bash scripts/sync-python.sh",
    "build": "bash scripts/sync-python.sh && node scripts/sync-hosting.mjs && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run ../../tests/typescript"
  },
  "optionalDependencies": {
    "@aws-sdk/client-lambda": "^3.500.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "document-ocr": "./scripts/dococr.mjs"
  }
}
